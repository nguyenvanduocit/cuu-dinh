{
  "name": "cuu-dinh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "typecheck": "bun run --cwd packages/shared typecheck && bun run --cwd apps/web typecheck",
    "content:gen": "bun tools/content-codegen/index.ts",
    "lint": "echo 'TODO: configure oxlint'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
